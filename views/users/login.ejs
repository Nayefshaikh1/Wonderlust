<% layout("/layouts/boilerplate") %>
<div style="max-width:680px; margin:0 auto; padding:0 24px 60px;">
  <div class="auth-card mt-5">
    <h2 class="auth-title">Log in to Wonderlust</h2>
    <form action="/login" method="post" class="needs-validation" novalidate>
      <div class="mb-4">
        <label class="auth-label">Username</label>
        <input name="username" id="username" type="text" class="form-control auth-input" required placeholder="Enter your username">
      </div>
      <div class="mb-4">
        <label class="auth-label">Password</label>
        <input name="password" id="password" type="password" class="form-control auth-input" required placeholder="Enter your password">
      </div>
      <button class="btn btn-brand w-100 py-3 mb-4">Log in</button>
      <p class="text-center text-muted" style="font-size:0.9rem;">
        Don't have an account? 
        <a href="/signup" class="fw-bold text-dark text-decoration-underline">Sign up</a>
      </p>
    </form>
  </div>
</div>