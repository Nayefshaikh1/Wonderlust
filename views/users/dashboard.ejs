<% layout("/layouts/boilerplate") %>
<div class="container mt-4 mb-5" style="max-width: 1000px;">
    <h1 class="mb-4">My Dashboard</h1>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">Manage My Listings</h4>
        <a href="/listings/new" class="btn btn-brand" style="border-radius: 8px;">
            <i class="fa-solid fa-plus me-1"></i> Add New Listing
        </a>
    </div>

    <% if(listings.length === 0) { %>
        <div class="alert bg-light border p-5 text-center rounded-4 mt-4">
            <i class="fa-solid fa-house mb-3" style="font-size: 3rem; color: #ddd;"></i>
            <h5>You don't have any listings yet.</h5>
            <p class="text-muted">Start earning by listing your beautiful property on Wonderlust today!</p>
            <a href="/listings/new" class="btn btn-brand mt-2 px-4 rounded-3">Airbnb your home</a>
        </div>
    <% } else { %>
        <div class="table-responsive rounded-4 shadow-sm border" style="background-color: white;">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f7f7f7;">
                    <tr>
                        <th scope="col" class="py-3 px-4 border-bottom-0 text-muted" style="font-size: 0.85rem;">PROPERTY</th>
                        <th scope="col" class="py-3 px-4 border-bottom-0 text-muted" style="font-size: 0.85rem;">LOCATION</th>
                        <th scope="col" class="py-3 px-4 border-bottom-0 text-muted" style="font-size: 0.85rem;">PRICE</th>
                        <th scope="col" class="py-3 px-4 border-bottom-0 text-muted text-end" style="font-size: 0.85rem;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <% for(let list of listings) { %>
                        <tr>
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center">
                                    <img src="<%= list.image %>" alt="image" style="height: 60px; width: 60px; object-fit: cover; border-radius: 8px; margin-right: 15px;">
                                    <span class="fw-bold fs-6"><%= list.title %></span>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-muted"><i class="fa-solid fa-location-dot me-1"></i> <%= list.location %>, <%= list.country %></td>
                            <td class="px-4 py-3 fw-semibold text-dark">&#8377;<%= Number(list.price).toLocaleString("en-IN") %></td>
                            <td class="px-4 py-3 text-end">
                                <a href="/listings/<%= list._id %>" class="btn btn-sm btn-outline-secondary me-1 px-3 fw-bold" style="border-radius: 8px;">View</a>
                                <a href="/listings/<%= list._id %>/edit" class="btn btn-sm btn-dark me-1 px-3 fw-bold" style="border-radius: 8px;">Edit</a>
                                <form action="/listings/<%= list._id %>?_method=DELETE" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger fw-bold px-3" style="border-radius: 8px;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
