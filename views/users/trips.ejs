<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5" style="max-width: 900px;">
    <h1 class="fw-bold mb-1">Trips</h1>
    <p class="text-muted mb-4">Your upcoming and past adventures</p>

    <% if(bookings.length === 0) { %>
        <div class="text-center py-5 mt-4">
            <i class="fa-solid fa-suitcase-rolling mb-4" style="font-size: 4rem; color: #ddd;"></i>
            <h4 class="fw-bold">No trips yet</h4>
            <p class="text-muted">When you book your next adventure, it'll appear here.</p>
            <a href="/listings" class="btn btn-dark mt-3 px-4 py-2 fw-bold" style="border-radius: 8px;">Start exploring</a>
        </div>
    <% } else { %>
        <div class="row g-4">
            <% for(let booking of bookings) { %>
                <% if(booking.listing) { %>
                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="cursor: default;">
                        <img src="<%= typeof booking.listing.image === 'object' && booking.listing.image ? booking.listing.image.url : booking.listing.image %>" alt="<%= booking.listing.title %>" style="height: 200px; object-fit: cover;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0"><%= booking.listing.title %></h5>
                                <span class="badge text-bg-light border text-dark fw-normal" style="border-radius: 20px; font-size: 0.8rem;">
                                    <%= booking.guests %> guest<%= booking.guests > 1 ? "s" : "" %>
                                </span>
                            </div>
                            <p class="text-muted mb-3" style="font-size: 0.9rem;">
                                <i class="fa-solid fa-location-dot me-1"></i>
                                <%= booking.listing.location %>, <%= booking.listing.country %>
                            </p>
                            <div class="d-flex gap-3 mb-3">
                                <div class="border rounded-3 px-3 py-2 flex-fill text-center">
                                    <small class="text-muted d-block fw-bold" style="font-size: 0.65rem;">CHECK-IN</small>
                                    <span class="fw-semibold" style="font-size: 0.9rem;">
                                        <%= new Date(booking.checkIn).toLocaleDateString("en-IN", {day:"numeric", month:"short", year:"numeric"}) %>
                                    </span>
                                </div>
                                <div class="border rounded-3 px-3 py-2 flex-fill text-center">
                                    <small class="text-muted d-block fw-bold" style="font-size: 0.65rem;">CHECK-OUT</small>
                                    <span class="fw-semibold" style="font-size: 0.9rem;">
                                        <%= new Date(booking.checkOut).toLocaleDateString("en-IN", {day:"numeric", month:"short", year:"numeric"}) %>
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                <span class="text-muted" style="font-size: 0.9rem;">Total paid</span>
                                <span class="fw-bold fs-5">&#8377;<%= Number(booking.totalPrice).toLocaleString("en-IN") %></span>
                            </div>
                            <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-dark w-100 mt-3 fw-bold" style="border-radius: 8px;">View listing</a>
                        </div>
                    </div>
                </div>
                <% } %>
            <% } %>
        </div>
    <% } %>
</div>
