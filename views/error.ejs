<% layout("/layouts/boilerplate") %>

<div class="container d-flex justify-content-center mt-5 mb-5">
    <div class="alert border-0 text-center rounded-4 shadow-sm py-5 px-4" role="alert" style="max-width: 500px; background-color: #FFF0F1; border: 1px solid #FFe0e1 !important;">
        <i class="fa-solid fa-circle-exclamation mb-3" style="font-size: 3.5rem; color: #FF385C;"></i>
        <h3 class="fw-bold text-dark mt-2 mb-3">Something went wrong!</h3>
        <p class="text-muted fs-6"><%= message %></p>
        <a href="/" class="btn btn-dark mt-3 fw-bold px-4 py-2" style="border-radius: 8px;">Back to Home</a>
    </div>
</div>

  